NEXT_PUBLIC_RECAPTCHA_SITE_KEY=RECAPTCHA_SITE_KEY_PLACEHOLDER
# Optional alias for clarity (server reads either of these)
RECAPTCHA_PUBLIC_KEY=

# For classic siteverify fallback (non-Enterprise)
RECAPTCHA_SECRET_KEY=

# Required for Enterprise Assessments
RECAPTCHA_PROJECT_ID=duosync-xxx
# If using a service account file, set:
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
