# DuoSync — copia questo file in `.env.local` e compila i valori
# (sono config client pubblica, non segreti: la sicurezza è nelle Firestore rules)

# Firebase Web SDK config (Console > Impostazioni progetto > SDK Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3) — site key pubblica
NEXT_PUBLIC_FIREBASE_RECAPTCHA_V3_SITE_KEY=

# Email dei due partner: NON committarle, usate solo da `npm run deploy:rules`
# per sostituire i placeholder in firestore.rules al momento del deploy.
DUOSYNC_EMAIL_1=
DUOSYNC_EMAIL_2=